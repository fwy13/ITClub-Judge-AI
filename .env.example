POSTGRES_PASSWORD=change-this-long-random-db-password
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
CSV_INTERNAL_KEY=change-this-private-service-token
WEB_BIND=127.0.0.1
FRONTEND_ORIGIN=http://localhost:8080
WORKER_CONCURRENCY=2
# Maximum combined private/public dataset size for one CSV challenge.
DATASET_MAX_MB=100

# Register with this username, then restart auth-api to promote that account to admin.
ADMIN_BOOTSTRAP_USERNAME=admin
# Use a randomly generated password of at least 16 characters, then remove it from the environment after initial setup.
ADMIN_BOOTSTRAP_PASSWORD=replace-with-long-random-password
